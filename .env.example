# ==============================================================================
# SkillBridge — Environment Variables Template
# Copy this file to .env.local for local testing with Vercel CLI.
# Add these variables in your Vercel Project Settings for production deployment.
# NEVER commit your actual API keys or secrets to Git.
# ==============================================================================

# (Option 1) Google Gemini AI API Key (Recommended)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Option 2) OpenAI API Key (Alternative)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Note: If no API key is set, SkillBridge automatically uses its comprehensive
# built-in local rule engine so the application remains 100% operational offline.
